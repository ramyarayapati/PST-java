import java.util.*;

class Task8 {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int n=s.nextInt();
        int m=s.nextInt();

        int[][] a=new int[n+1][n+1];

        for(int i=0;i<m;i++) {
            int x=s.nextInt();
            int y=s.nextInt();
            a[x][y]=a[y][x]=1;
        }

        int x=s.nextInt();
        int y=s.nextInt();

        if(a[x][y]==1)
            System.out.println("YES");
        else
            System.out.println("NO");
    }
}
