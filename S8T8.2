class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int currentAlt = 0; // Starting altitude
        int maxAlt = 0;     // Track the highest point
        
        for (int g : gain) {
            currentAlt += g;          // Update current altitude
            maxAlt = max(maxAlt, currentAlt); // Update max if needed
        }
        
        return maxAlt;
    }
};
